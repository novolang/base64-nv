// tests/differential_tests.nv — this package against the standard
// library's base64, over a few thousand random byte strings.
//
// A second implementation is the reference here.  RFC 4648 § 10's eight
// vectors are in `base64_tests.nv` and they are the specification, but
// eight documents of at most six bytes do not reach a group boundary
// twice, a byte above 127, or the two table entries only a particular
// bit pattern selects.  `bytes.to_base64` is an extern over a host C
// symbol, written by somebody else in another language from the same
// document, which is what an independent second opinion should be.
//
// What is compared, for each input:
//
//   1. the standard alphabet, padded, against `bytes.to_base64`;
//   2. our decode of our own text, against the bytes that went in;
//   3. `bytes.from_base64` reading our text, so the agreement is
//      checked in both directions rather than only on the way out;
//   4. the URL-safe alphabet and the unpadded form round-tripping,
//      which the standard library has no spelling for at all;
//   5. `encode_into` and `decode_into` over a caller's buffer, against
//      the allocating pair, because the two entry points are one
//      machine and a difference between them would be a bug here.
//
// The inputs are deterministic.  The generator is a thirty-two-bit
// linear congruential sequence written here rather than `std.rand`, for
// two reasons.  A failure has to be reproducible from the file alone.
// And `rand.int` carries the `[rand]` effect, which a package whose
// layer is `core` spends nowhere, not even in a test.
//
// The same file is also a program.  `novo test` runs the `@test`
// functions on compiled code, and
// `novo run --interp tests/differential_tests.nv` runs `main`, which is
// the same loop on the reference interpreter.  Both are run before a
// release, because a code generation bug and an interpreter bug are
// different bugs.

use std.test
use std.bytes
use base64

// How many inputs a full run compares.  Three thousand at lengths up to
// 48 bytes is about fifty thousand quanta, which crosses every group
// boundary and every table entry many times over.
fn trials() -> Int
    3000

// One step of a 32-bit linear congruential generator — Numerical
// Recipes' constants, and the arithmetic stays far below the point
// novo-lang's `+` would trap.
fn lcg(state: Int) -> Int
    (state * 1664525 + 1013904223) & 0xFFFFFFFF

// `n` pseudo-random bytes.  The high bits are the ones an LCG makes
// well, so the byte is taken from the top of the word.
fn draw(state: Int, n: Int) -> Bytes
    var s = state
    var out = bytes.zeros(n)
    for i in 0..n
        s = lcg(s)
        out = bytes.set_u8(out, i, (s >>> 24) & 255)
    out

fn advance(state: Int, n: Int) -> Int
    var s = state
    for i in 0..n
        s = lcg(s)
    s

// The comparison, for one input.  Answers the empty string when the
// two implementations agree and a sentence naming the disagreement
// when they do not, so both the `@test` and `main` report the same
// thing.
fn compare(src: Bytes) -> Str
    let want = bytes.to_base64(src)
    let ours = base64.encode(src, B64Standard, B64Padded)
    if ours != want
        return "encode: ours `${ours}`, std `${want}`"
    let hex = bytes.to_hex(src)
    // Our decoder over our text.
    match base64.decode(ours, B64Standard)
        Err(e) =>
            return "decode refused our own text: ${e.message()}"
        Ok(b)  =>
            if bytes.to_hex(b) != hex
                return "decode: `${bytes.to_hex(b)}` from `${hex}`"
    // The standard library's decoder over our text.
    match bytes.from_base64(ours)
        None    =>
            return "std refused our text `${ours}`"
        Some(b) =>
            if bytes.to_hex(b) != hex
                return "std decode: `${bytes.to_hex(b)}` from `${hex}`"
    // The URL-safe alphabet and the unpadded form, which the standard
    // library cannot write and so can only be checked round-trip.
    let websafe = base64.encode(src, B64UrlSafe, B64Unpadded)
    match base64.decode(websafe, B64UrlSafe)
        Err(e) =>
            return "url-safe unpadded refused: ${e.message()}"
        Ok(b)  =>
            if bytes.to_hex(b) != hex
                return "url-safe unpadded: `${bytes.to_hex(b)}` from `${hex}`"
    let bare = base64.encode(src, B64Standard, B64Unpadded)
    match base64.decode(bare, B64Standard)
        Err(e) =>
            return "unpadded refused: ${e.message()}"
        Ok(b)  =>
            if bytes.to_hex(b) != hex
                return "unpadded: `${bytes.to_hex(b)}` from `${hex}`"
    // And the buffer pair, which is the same machine with a different
    // destination.
    let room = base64.encoded_len(bytes.len(src), B64Padded)
    var enc_dst = bytes.cursor_le(bytes.zeros(room + 1))
    match base64.encode_into(src, B64Standard, B64Padded, enc_dst)
        Err(e) =>
            return "encode_into refused: ${e.message()}"
        Ok(n)  =>
            if bytes.to_str(bytes.slice(enc_dst.finish(), 0, n)) != ours
                return "encode_into disagrees with encode on `${hex}`"
    var dec_dst = bytes.cursor_le(bytes.zeros(bytes.len(src) + 1))
    match base64.decode_into(ours, B64Standard, dec_dst)
        Err(e) =>
            return "decode_into refused: ${e.message()}"
        Ok(n)  =>
            if bytes.to_hex(bytes.slice(dec_dst.finish(), 0, n)) != hex
                return "decode_into disagrees with decode on `${hex}`"
    ""

// The whole run: `trials()` inputs of every length from 0 to 48.
// Answers the first disagreement, or the empty string.
fn sweep() -> Str
    var s = 20260918
    for i in 0..trials()
        s = lcg(s)
        let n = (s >>> 16) % 49
        let src = draw(s, n)
        s = advance(s, n)
        let bad = compare(src)
        if bad != ""
            return "trial ${i}, ${n} byte(s): ${bad}"
    ""

@test
fn test_this_package_and_the_standard_library_agree_on_random_bytes()
    let bad = sweep()
    test.assert_eq(bad, "")

@test
fn test_every_length_across_two_group_boundaries_round_trips()
    // The lengths the random sweep also reaches, walked in order, so a
    // failure names the length rather than a trial number.  0 to 12 is
    // four whole groups and every remainder four times.
    var s = 7
    for n in 0..13
        s = lcg(s)
        let src = draw(s, n)
        let bad = compare(src)
        test.assert_eq("${n}: ${bad}", "${n}: ")

fn main() [io]
    // The same comparison on the reference interpreter.  `novo test`
    // runs the two `@test` functions above on compiled code, and a code
    // generation bug cannot hide from both.
    let bad = sweep()
    if bad != ""
        println("base64-nv differential: FAILED — ${bad}")
        return
    println("base64-nv differential: ${trials()} random inputs, this package and std.bytes agree")
