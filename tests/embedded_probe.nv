// tests/embedded_probe.nv — `base64_core` on a microcontroller, as a
// program that builds for a Cortex-M, boots there and checks its
// answers.
//
// This file and the modules its `use` lines reach are built with
//
//   novo build --target=nrf52-qemu tests/embedded_probe.nv
//
// which produces a Cortex-M4 ELF or fails.  Running on a device is the
// reason the package exists beside the standard library.
// `bytes.to_base64` is an extern over a host C symbol, and a device
// that called it would fail at the linker.
//
// The same ELF boots under
//
//   qemu-system-arm -machine mps2-an386 -nographic -semihosting -kernel probe.elf
//
// and writes `ok` for each of the four things it checks.  The build
// checks something the run cannot.  `--target=nrf52-qemu` stamps
// `@tier(embedded)` on every function it compiles, so a `Str`
// concatenation, a `Bytes` call or an unbounded `while` is refused
// wherever it is written.
//
// The answers are printed as `ok` rather than as the characters
// themselves.  Turning a byte into text is `str.from_byte`, which is
// host-only, so a device that printed the encoding would not be a
// device program.  The comparisons are made against integer literals
// and the verdict is a literal too.
//
// The `base64` module is not used here.  It speaks `Bytes` and `Str`,
// the embedded runtime defines neither, and one host-only function
// anywhere in a compilation unit is an undefined symbol at link time
// whether or not the firmware calls it.

use base64_core

// Three bytes the way firmware would hold them.
//
// The array is a field of a `@value` struct rather than a return type.
// `[u8; 3]` is a true inline array only inside one.  Outside, the
// annotation still means a list, and a list literal is an implicit heap
// allocation a device build refuses (SPEC § 14.4).
@value
struct ProbeGroup
    b: [u8; 3]

// "Man" — RFC 4648's own worked example, and the one group that
// encodes to four characters with no padding at all.
fn probe_group() -> ProbeGroup
    ProbeGroup { b: [77 as u8, 97 as u8, 110 as u8] }

// `TWFu`, the four characters "Man" encodes to, as the ASCII bytes a
// device compares against.
@value
struct ProbeText
    c: [u8; 4]

fn probe_text() -> ProbeText
    ProbeText { c: [84 as u8, 87 as u8, 70 as u8, 117 as u8] }

fn say(label: Str, good: Bool) [hw]
    hal.uart.write(label)
    if good
        hal.uart.write(": ok\n")
    else
        hal.uart.write(": BAD\n")

fn main() [hw]
    // The constants and the arithmetic, so a device that sizes a
    // transmit buffer compiles the same numbers the host does.
    let std_alpha = base64_core.standard()
    let url_alpha = base64_core.url_safe()
    var good = base64_core.group_bytes() == 3 and base64_core.group_chars() == 4
    good = good and base64_core.encoded_len(64, true) == 88
    good = good and base64_core.decoded_len(88, true) == 66
    good = good and base64_core.encoded_len(64, false) == 86
    say("sizes", good)

    // The two tables, read directly.  That is what a decoder's inner
    // loop does before it shifts anything, and it reaches the two
    // characters where RFC 4648 § 4 and § 5 differ.
    good = base64_core.symbol(std_alpha, 0) == 65
    good = good and base64_core.symbol(std_alpha, 63) == 47
    good = good and base64_core.symbol(url_alpha, 63) == 95
    good = good and base64_core.value(url_alpha, 45) == 62
    good = good and base64_core.value(std_alpha, 45) == 0 - 1
    say("tables", good)

    // The encoder driven a byte at a time, which is the shape a device
    // streaming a sensor batch out as text has.  One byte goes in, zero
    // or four characters come out, and nothing is allocated to pass
    // either.
    //
    // Each step is bound with its type written out because a call into
    // another module does not have its return type inferred in a
    // single-file build.  Inside a package built as one unit — which is
    // what every host suite does — none of these annotations is needed.
    let src = probe_group()
    let want = probe_text()
    var written = 0
    good = true
    var e: B64Enc = base64_core.encoder(std_alpha)
    for i in 0..3
        let step: B64Emit = base64_core.push(e, src.b[i])
        e = step.enc
        for k in 0..step.len
            let c: u8 = step.out[k]
            if c != want.c[written]
                good = false
            written = written + 1
    // And the close, which is where padding comes from.  A whole group
    // leaves nothing to close, so this adds no characters at all.
    let last: B64Emit = base64_core.finish(e, true)
    good = good and written == 4 and last.len == 0
    say("encode", good)

    // The decoder's mirror, so both directions are compiled for the
    // device rather than only the one a sender needs.
    var d: B64Dec = base64_core.decoder(std_alpha)
    var read = 0
    good = true
    for i in 0..4
        let got: B64Drain = base64_core.feed(d, want.c[i])
        d = got.dec
        if not got.ok
            good = false
        for k in 0..got.len
            let b: u8 = got.out[k]
            if b != src.b[read]
                good = false
            read = read + 1
    let done: B64Drain = base64_core.close(d)
    good = good and read == 3 and done.ok and done.len == 0
    say("decode", good)

    hal.uart.write("base64-nv: three bytes, four characters\n")
