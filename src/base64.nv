// base64 — RFC 4648 over bytes and text the caller already holds.
//
// `base64_core` is the state machine: three integers, no buffer and no
// allocation.  This module is that machine with a `Bytes` source and a
// `Str` destination attached, so a caller who already has the whole
// payload does not write the group loop.  Everything here is arithmetic
// over bytes the caller holds.  Nothing is read and nothing is written,
// which is why the layer is `core` and no function declares an effect.
//
// The standard library's `Base64` codec calls `bytes.to_base64`, which
// is an extern over a host C symbol.  It is the right thing to reach
// for on a host.  It has no URL-safe alphabet, no unpadded form, no
// size arithmetic and no way to encode a stream a chunk at a time, and
// it does not link on a device.  The README has the table saying which
// one to reach for.
//
// The size functions come first because a caller that wants
// `encode_into` has to size the destination before it can make one.
// `encoded_len` and `decoded_len` are part of the published surface
// rather than a convenience on top of it.
//
// Decoding reads the document twice.  `fault` reads it and writes
// nothing, and only once it has answered `None` does either decoder put
// a byte anywhere.  So nothing is written for any refusal and not only
// for a destination that was too short, at the cost of one extra pass
// over text that is already in memory.
//
// The `use base64_core` line below is needed for the calls.  A type
// declared in the other module is visible here by name with no import,
// which is why `B64Enc` is spelled bare, but a call is not.
// `base64_core.encoder` needs the module in scope, and this package has
// two functions named `encoder` with one argument each.  Without the
// import a single-file build resolves the qualified call to the one in
// this module and reports a type error at a line that is correct.

use std.bytes
use std.str
use base64_core

// Which of RFC 4648's two tables a document uses.
//
// The two differ in two characters out of sixty-four.  A document
// decoded with the wrong one does not fail, it produces different
// bytes, so the alphabet is an argument with no default on every call
// that could care.
pub enum B64Alphabet
    // `A`–`Z`, `a`–`z`, `0`–`9`, `+`, `/` (RFC 4648 § 4).  What `base64`
    // means when nobody says otherwise.
    B64Standard
    // `A`–`Z`, `a`–`z`, `0`–`9`, `-`, `_` (RFC 4648 § 5).  JWTs, WebPush
    // keys, and anything that has to survive a URL or a filename.
    B64UrlSafe

// Whether a document ends with `=` characters up to a multiple of four.
//
// Padding carries no information, because the length already says how
// many bytes the last group held.  It exists to let a decoder reading
// concatenated documents find the boundaries.  A caller decoding one
// document does not need it, which is why most URL-safe uses dropped
// it.
pub enum B64Padding
    // `=` up to a multiple of four.  RFC 4648 § 3.2 requires this
    // unless the specification using base64 says otherwise.
    B64Padded
    // No `=` at all.  What JWT (RFC 7515 § 2) and most URL-safe uses
    // specify.
    B64Unpadded

// What went wrong decoding, or sizing a buffer to encode into.
//
// The names carry a prefix because a variant is constructed by name
// across the whole assembly, and `BadLength` is the name every codec
// wants.
pub enum B64Error
    // A character that is in neither the alphabet nor the padding.
    //
    // `at` is the character offset and `ch` is the byte, so a caller
    // can print the document with a caret under the problem.  Newlines
    // are included: RFC 4648 § 3.3 says a decoder rejects characters
    // outside the alphabet unless the specification using it says
    // otherwise, and a caller decoding MIME strips the line breaks
    // first.
    B64BadCharacter(at: Int, ch: Int)
    // A length no encoding can produce: not a multiple of four when
    // padded, or a remainder of one either way.  One leftover character
    // would carry six bits of a byte that has eight.
    B64BadLength(len: Int)
    // `=` somewhere other than at the end, or more than two of them.
    B64BadPadding(at: Int)
    // A final quantum whose unused low bits are not zero.
    //
    // RFC 4648 § 3.5 calls this non-canonical.  `QQ` and `QR` both
    // decode to the single byte `A`, so a system that treats a base64
    // string as an identity, such as a signature, a cache key or a
    // token, has two spellings of one value unless the decoder refuses
    // one.
    B64NonCanonicalTail(at: Int, ch: Int)
    // The destination handed to `encode_into` or `decode_into` was
    // shorter than the answer.  `need` is what `encoded_len` or
    // `decoded_len` would have said.
    B64BufferTooSmall(need: Int, have: Int)

// The standard `Error` implementation, so a bad document can be
// reported by anything that reports errors.
impl Error for B64Error
    // Answer the one-line report, naming what was wrong and the
    // character offset it was at.  The offset is in the message rather
    // than left for the caller to add, because a base64 document has no
    // other landmark.
    fn message(self) -> Str
        match self
            B64BadCharacter(at, ch)       =>
                "at ${at}: byte ${ch} is not in this base64 alphabet"
            B64BadLength(len)             =>
                "${len} characters is not a length base64 produces"
            B64BadPadding(at)             =>
                "at ${at}: `=` is only ever at the end, and never more than twice"
            B64NonCanonicalTail(at, ch)   =>
                "at ${at}: `${str.from_byte(ch)}` sets bits the final quantum does not carry (RFC 4648 § 3.5)"
            B64BufferTooSmall(need, have) =>
                "the destination holds ${have} bytes and the answer is ${need}"

// The padding argument as the boolean `base64_core` takes.
fn padded(pad: B64Padding) -> Bool
    match pad
        B64Padded   => true
        B64Unpadded => false

// The `=` characters at the end of `s`, counted.
//
// Only the ones at the end are counted, because they are what tells a
// padded document from an unpadded one.  `=` anywhere else is `fault`'s
// to refuse.
fn trailing_pads(s: Str) -> Int
    let n = str.len(s)
    var pads = 0
    for i in 0..n
        if str.byte_at_or(s, n - 1 - i, 0) != 61
            return pads
        pads = pads + 1
    pads

// The length of the document's body — its characters before the
// padding — or the refusal its shape earns.
//
// Reads the length and the trailing `=` and nothing else, so a document
// full of characters that turn out to be invalid frames just fine and
// is refused a pass later.  That is what makes `decoded_len` cheap
// enough to size a buffer with.
fn frame(s: Str) -> Result<Int, B64Error>
    let n = str.len(s)
    let pads = trailing_pads(s)
    if pads > 2
        return Err(B64BadPadding(n - pads + 2))
    if pads > 0 and (n & 3) != 0
        return Err(B64BadLength(n))
    let body = n - pads
    if (body & 3) == 1
        return Err(B64BadLength(n))
    Ok(body)

// The refusal the document carries, or `None` if it carries none.
//
// The pass both decoders take before either writes a byte.  It reads
// every character of the body through `base64_core` and keeps nothing,
// so a caller's buffer is untouched by a document that turns out to be
// bad.
//
// A character outside the alphabet is reported before a length no
// encoding produces, and the order is part of the answer a reader gets.
// A MIME document wrapped at 76 characters has a line break in it and a
// length no encoding produces, and both are true of the same string.
// The line break is the useful half, because that is the thing to
// strip.  An unknown character is therefore reported where it stands,
// and the length is what is left over once every character was in the
// alphabet.
fn fault(s: Str, alpha: Int) -> ?B64Error
    let body = str.len(s) - trailing_pads(s)
    var d = base64_core.decoder(alpha)
    for i in 0..body
        let ch = str.byte_at_or(s, i, 0)
        if ch == 61
            return Some(B64BadPadding(i))
        let step = base64_core.feed(d, ch as u8)
        if not step.ok
            return Some(B64BadCharacter(i, ch))
        d = step.dec
    match frame(s)
        Err(e) => Some(e)
        Ok(_)  =>
            if not base64_core.close(d).ok
                // `frame` has already refused a body whose remainder is
                // one, so the only way to be here is RFC 4648 § 3.5's
                // tail: the last character sets bits the quantum does
                // not carry.
                let at = body - 1
                return Some(B64NonCanonicalTail(at, str.byte_at_or(s, at, 0)))
            None

// The alphabet as the integer `base64_core` stores.
//
// The bridge between the two halves.  The enum is what a host caller
// reads, and the integer is what survives `@value` on a device.  A
// program that sets a stream up on the host and encodes it on a device
// needs this one function.
//
// ```novo
// use base64
//
// fn main() [io]
//     println("${base64.alphabet_code(B64Standard)}")   // 0
// ```
pub fn alphabet_code(a: B64Alphabet) -> Int
    match a
        B64Standard => base64_core.standard()
        B64UrlSafe  => base64_core.url_safe()

// How many characters `n` bytes encode to.
//
// What a caller sizing the destination for `encode_into` asks first.
//
// ```novo
// use base64
//
// fn main() [io]
//     // "Man" is three bytes and four characters, padded or not.
//     println("${base64.encoded_len(3, B64Padded)} ${base64.encoded_len(1, B64Unpadded)}")
//     // 4 2
// ```
pub fn encoded_len(n: Int, pad: B64Padding) -> Int
    base64_core.encoded_len(n, padded(pad))

// How many bytes `s` decodes to, without decoding it.
//
// Reads the length and the trailing `=` characters and nothing else.
// It is `B64BadLength` for a length no encoding can produce, and `Ok`
// for a document full of characters that turn out to be invalid.  A
// caller sizing a destination wants the number, and a caller checking a
// document wants `decode`.
//
// ```novo
// use base64
//
// fn main() [io]
//     match base64.decoded_len("TWFu")
//         Ok(n)  => println("${n}")   // 3
//         Err(e) => println(e.message())
// ```
pub fn decoded_len(s: Str) -> Result<Int, B64Error>
    match frame(s)
        Err(e)   => Err(e)
        Ok(body) => Ok(base64_core.decoded_len(body, false))

// Encode `src` as text.
//
// The call for a caller who wants the string and does not care where
// the bytes came from.  It cannot fail, because every byte sequence has
// an encoding.
//
// ```novo
// use std.bytes
// use base64
//
// fn main() [io]
//     println(base64.encode(bytes.from_str("Man"), B64Standard, B64Padded))
//     // TWFu
// ```
pub fn encode(src: Bytes, alphabet: B64Alphabet, pad: B64Padding) -> Str
    let n = bytes.len(src)
    let want = base64_core.encoded_len(n, padded(pad))
    var out = bytes.zeros(want)
    var w = 0
    var e = base64_core.encoder(alphabet_code(alphabet))
    for i in 0..n
        let step = base64_core.push(e, (bytes.byte_at(src, i) ?? 0) as u8)
        e = step.enc
        for k in 0..step.len
            out = bytes.set_u8(out, w, step.out[k] as Int)
            w = w + 1
    let last = base64_core.finish(e, padded(pad))
    for k in 0..last.len
        out = bytes.set_u8(out, w, last.out[k] as Int)
        w = w + 1
    bytes.to_str(out)

// Encode `src` into a buffer the caller already owns, and answer the
// characters written.
//
// The answer is `B64BufferTooSmall` when the cursor has less room than
// `encoded_len` says, and nothing is written in that case.  A partially
// encoded buffer is worse than none, because it looks like a
// document.
//
// This is the call for a program that encodes on a schedule.  It
// allocates the destination once and reuses it, and the arithmetic that
// sizes it is `encoded_len`.
pub fn encode_into(src: Bytes, alphabet: B64Alphabet, pad: B64Padding,
                   mut dst: Cursor) -> Result<Int, B64Error>
    let n = bytes.len(src)
    let want = base64_core.encoded_len(n, padded(pad))
    let have = dst.remaining()
    if want > have
        return Err(B64BufferTooSmall(want, have))
    var e = base64_core.encoder(alphabet_code(alphabet))
    for i in 0..n
        let step = base64_core.push(e, (bytes.byte_at(src, i) ?? 0) as u8)
        e = step.enc
        for k in 0..step.len
            dst.put_u8(step.out[k] as Int)
    let last = base64_core.finish(e, padded(pad))
    for k in 0..last.len
        dst.put_u8(last.out[k] as Int)
    Ok(want)

// Decode `s` back to bytes.
//
// The document says whether it is padded, rather than an argument.  A
// string that ends in `=` is padded and one that does not is not, and
// both are read.  Four things are refused: `=` in the middle
// (`B64BadPadding`), a character outside the alphabet
// (`B64BadCharacter`), a length no encoding produces (`B64BadLength`),
// and a final quantum with its unused bits set
// (`B64NonCanonicalTail`).
//
// ```novo
// use std.bytes
// use base64
//
// fn main() [io]
//     match base64.decode("TWFu", B64Standard)
//         Ok(b)  => println(bytes.to_hex(b))   // 4d616e
//         Err(e) => println(e.message())
// ```
pub fn decode(s: Str, alphabet: B64Alphabet) -> Result<Bytes, B64Error>
    let alpha = alphabet_code(alphabet)
    match fault(s, alpha)
        Some(e) => Err(e)
        None    =>
            let body = str.len(s) - trailing_pads(s)
            var out = bytes.zeros(base64_core.decoded_len(body, false))
            var w = 0
            var d = base64_core.decoder(alpha)
            for i in 0..body
                let step = base64_core.feed(d, str.byte_at_or(s, i, 0) as u8)
                d = step.dec
                for k in 0..step.len
                    out = bytes.set_u8(out, w, step.out[k] as Int)
                    w = w + 1
            let last = base64_core.close(d)
            for k in 0..last.len
                out = bytes.set_u8(out, w, last.out[k] as Int)
                w = w + 1
            Ok(out)

// Decode `s` into a buffer the caller already owns, and answer the
// bytes written.
//
// The mirror of `encode_into`, under the same rule.  It answers
// `B64BufferTooSmall` when the cursor has less room than `decoded_len`
// says, and writes nothing in that case.  A document refused for any
// other reason writes nothing either, because `fault` reads the whole
// of it before the first byte lands.
pub fn decode_into(s: Str, alphabet: B64Alphabet, mut dst: Cursor) -> Result<Int, B64Error>
    let alpha = alphabet_code(alphabet)
    match fault(s, alpha)
        Some(e) => Err(e)
        None    =>
            let body = str.len(s) - trailing_pads(s)
            let want = base64_core.decoded_len(body, false)
            let have = dst.remaining()
            if want > have
                return Err(B64BufferTooSmall(want, have))
            var d = base64_core.decoder(alpha)
            for i in 0..body
                let step = base64_core.feed(d, str.byte_at_or(s, i, 0) as u8)
                d = step.dec
                for k in 0..step.len
                    dst.put_u8(step.out[k] as Int)
            let last = base64_core.close(d)
            for k in 0..last.len
                dst.put_u8(last.out[k] as Int)
            Ok(want)

// ── Streaming, for a payload that is larger than memory ─────────────

// An encoder over `alphabet`, as `base64_core` holds it.
//
// The handoff to the device half, and the answer for a caller encoding
// a stream.  Feed bytes with `base64_core.push`, write the four
// characters each completed group produces, and call
// `base64_core.finish` when the stream ends.  Nothing is buffered, so
// the payload never has to fit anywhere.
//
// A chunked caller on the host does the same thing one `Bytes` at a
// time; the encoder is the value it carries between chunks.
pub fn encoder(alphabet: B64Alphabet) -> B64Enc
    base64_core.encoder(alphabet_code(alphabet))

// A decoder over `alphabet`, as `base64_core` holds it.
//
// The mirror of `encoder`, in the same shape.  Feed characters, take
// the three bytes each completed group produces, and call
// `base64_core.close` at the end.
pub fn decoder(alphabet: B64Alphabet) -> B64Dec
    base64_core.decoder(alphabet_code(alphabet))
